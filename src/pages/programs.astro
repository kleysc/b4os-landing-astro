          <p class="hero-description">{t.programs.hero.description}</p>
        </div>
      </div>
    </section>

    <section class="programs-content">
      <div class="container">
        <div class="filters">
          <button class="filter-btn active" data-filter="all">{t.programs.filters.all}</button>
          <button class="filter-btn" data-filter="open">{t.programs.filters.open}</button>
          <button class="filter-btn" data-filter="upcoming">{t.programs.filters.upcoming}</button>
          <button class="filter-btn" data-filter="completed">{t.programs.filters.completed}</button>
          <button class="filter-btn" data-filter="event">{t.programs.filters.events}</button>
        </div>

        <div class="programs-grid">
          {programs.map((program) => (
            <div class="program-card" data-status={program.status}>
              <span class={`status-badge status-${program.status}`}>
                {t.programs.statusLabels[program.status]}
              </span>
              <h3 class="program-title">{program.title}</h3>
              <div class="program-date">{program.date}</div>
              <p class="program-description">{program.description}</p>
              <a href={program.ctaUrl} class={`btn btn-${program.ctaStyle}`}>
                {program.ctaText}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const programCards = document.querySelectorAll('.program-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;

          // Update active button
          filterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          // Filter cards
          programCards.forEach(card => {
            const status = card.dataset.status;
            let show = false;

            switch(filter) {
              case 'all':
                show = true;
                break;
              case 'open':
                show = status === 'open';
                break;
              case 'upcoming':
                show = status === 'upcoming';
                break;
              case 'completed':
                show = status === 'completed' || status === 'in-progress';
                break;
              case 'event':
                show = status === 'event';
                break;
            }

            card.style.display = show ? 'block' : 'none';
          });
        });
      });
    });
  </script>
</Layout>

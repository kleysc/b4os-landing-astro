---
import Layout from '../../../layouts/Layout.astro';
import { getTranslation } from '../../../i18n/utils.js';
import '../../../styles/enroll.css';

export const prerender = true;

export async function getStaticPaths() {
  const cohorts = [
    'b4os-2024',
    'b4os-2025-1',
    'b4os-2025-2',
    'b4os-2026-1',
    'b4os-2026-2',
    'conferencia-b4os-2026',
    'b4os-2027',
    'chaincode-2025'
  ];

  const paths = [];

  for (const cohort of cohorts) {
    // Spanish (default, no prefix)
    paths.push({ params: { cohort } });
  }

  return paths;
}

const { cohort } = Astro.params;
const locale = 'en';
const t = getTranslation(locale);

// Cohort-specific data
const cohortData = {
  'b4os-2024': {
    title: 'B4OS 2024',
    subtitle: t.enroll?.b4os2024?.subtitle || 'Programa completado - Buenos Aires',
    status: 'completed',
    dates: t.enroll?.b4os2024?.dates || 'Marzo - Junio 2024',
    description: t.enroll?.b4os2024?.description || 'La primera cohorte de B4OS fue completada exitosamente en Buenos Aires con desarrolladores de toda América Latina.',
    highlights: [
      t.enroll?.b4os2024?.highlight1 || '15 desarrolladores graduados',
      t.enroll?.b4os2024?.highlight2 || 'Residencia presencial de 2 semanas',
      t.enroll?.b4os2024?.highlight3 || 'Múltiples grants otorgados'
    ]
  },
  'b4os-2025-1': {
    title: 'B4OS 2025-1',
    subtitle: t.enroll?.b4os2025_1?.subtitle || 'Programa en desarrollo',
    status: 'in-progress',
    dates: t.enroll?.b4os2025_1?.dates || 'En progreso',
    description: t.enroll?.b4os2025_1?.description || 'Cohorte actualmente en desarrollo con participantes trabajando en contribuciones a Bitcoin Core y Lightning Network.',
    highlights: [
      t.enroll?.b4os2025_1?.highlight1 || 'Programa activo',
      t.enroll?.b4os2025_1?.highlight2 || 'Contribuciones en curso',
      t.enroll?.b4os2025_1?.highlight3 || 'Mentorías especializadas'
    ]
  },
  'b4os-2025-2': {
    title: 'B4OS 2025-2',
    subtitle: t.enroll?.b4os2025_2?.subtitle || 'Inscripciones Abiertas',
    status: 'open',
    dates: t.enroll?.b4os2025_2?.dates || 'Noviembre 2025',
    description: t.enroll?.b4os2025_2?.description || 'Las inscripciones para esta cohorte están abiertas. Únete a la próxima generación de desarrolladores Bitcoin.',
    highlights: [
      t.enroll?.b4os2025_2?.highlight1 || 'Registro abre en octubre 2025',
      t.enroll?.b4os2025_2?.highlight2 || 'Enfoque en Bitcoin Core',
      t.enroll?.b4os2025_2?.highlight3 || 'Residencia en Sudamérica'
    ]
  },
  'b4os-2026-1': {
    title: 'B4OS Enero 2026-1',
    subtitle: t.enroll?.b4os2026_1?.subtitle || 'Partnership con Chaincode Labs',
    status: 'upcoming',
    dates: t.enroll?.b4os2026_1?.dates || 'Enero 2026',
    description: t.enroll?.b4os2026_1?.description || 'Programa especial en colaboración con Chaincode Labs. Las inscripciones abren el 1 de diciembre.',
    highlights: [
      t.enroll?.b4os2026_1?.highlight1 || 'Partnership con Chaincode Labs',
      t.enroll?.b4os2026_1?.highlight2 || 'Mentores de clase mundial',
      t.enroll?.b4os2026_1?.highlight3 || 'Registro abre el 1 de diciembre'
    ]
  },
  'b4os-2026-2': {
    title: 'B4OS 2026-2',
    subtitle: t.enroll?.b4os2026_2?.subtitle || 'En planificación',
    status: 'upcoming',
    dates: t.enroll?.b4os2026_2?.dates || 'Marzo 2026',
    description: t.enroll?.b4os2026_2?.description || 'Programa en desarrollo en conjunto con la ONG Bitcoin Argentina. Los detalles se anunciarán próximamente.',
    highlights: [
      t.enroll?.b4os2026_2?.highlight1 || 'Colaboración con Bitcoin Argentina',
      t.enroll?.b4os2026_2?.highlight2 || 'Detalles próximamente',
      t.enroll?.b4os2026_2?.highlight3 || 'Enfoque regional'
    ]
  },
  'conferencia-b4os-2026': {
    title: t.enroll?.conferencia2026?.title || 'Conferencia B4OS',
    subtitle: t.enroll?.conferencia2026?.subtitle || 'Evento anual de la comunidad',
    status: 'event',
    dates: t.enroll?.conferencia2026?.dates || 'Octubre 2026 - Ciudad de México',
    description: t.enroll?.conferencia2026?.description || 'Evento anual de la comunidad B4OS con conferencias, workshops, networking y presentación de proyectos.',
    highlights: [
      t.enroll?.conferencia2026?.highlight1 || 'Conferencias técnicas',
      t.enroll?.conferencia2026?.highlight2 || 'Workshops prácticos',
      t.enroll?.conferencia2026?.highlight3 || 'Networking con la comunidad'
    ]
  },
  'b4os-2027': {
    title: 'B4OS 2027',
    subtitle: t.enroll?.b4os2027?.subtitle || 'Futuro programa',
    status: 'upcoming',
    dates: t.enroll?.b4os2027?.dates || 'Marzo 2027',
    description: t.enroll?.b4os2027?.description || 'Programa en planificación. Los detalles se anunciarán próximamente.',
    highlights: [
      t.enroll?.b4os2027?.highlight1 || 'En planificación',
      t.enroll?.b4os2027?.highlight2 || 'Detalles próximamente',
      t.enroll?.b4os2027?.highlight3 || 'Sé el primero en enterarte'
    ]
  },
  'chaincode-2025': {
    title: 'Chaincode Labs 2025',
    subtitle: t.enroll?.chaincode2025?.subtitle || 'Program with Chaincode Labs',
    status: 'upcoming',
    dates: t.enroll?.chaincode2025?.dates || '2025',
    description: t.enroll?.chaincode2025?.description || 'Program in collaboration with Chaincode Labs. A unique opportunity for developers looking to contribute to Bitcoin and Lightning Network development.',
    highlights: [
      t.enroll?.chaincode2025?.highlight1 || 'Chaincode Labs',
      t.enroll?.chaincode2025?.highlight2 || 'Specialized mentoring',
      t.enroll?.chaincode2025?.highlight3 || 'Focus on Bitcoin Core and Lightning'
    ]
  }
};

const currentCohort = cohortData[cohort] || cohortData['b4os-2024'];
const pageTitle = `${currentCohort.title} - ${t.enroll?.meta?.titleSuffix || 'B4OS Enrollment'}`;
const pageDescription = currentCohort.description;
---

<Layout title={pageTitle} description={pageDescription} locale={locale}>
  <main class="enroll-page">
    <section class="enroll-hero">
      <div class="container">
        <div class="breadcrumb">
          <a href={`/${locale === 'es' ? '' : locale + '/'}programs`}>
            {t.enroll?.breadcrumb?.programs || 'Programs'}
          </a>
          <span class="separator">/</span>
          <span>{currentCohort.title}</span>
        </div>

        <div class={`status-badge status-${currentCohort.status}`}>
          {t.programs?.statusLabels?.[currentCohort.status] || currentCohort.status}
        </div>

        <h1 class="enroll-title">{currentCohort.title}</h1>
        <p class="enroll-subtitle">{currentCohort.subtitle}</p>
        <p class="enroll-dates">{currentCohort.dates}</p>
      </div>
    </section>

    <section class="enroll-content">
      <div class="container">
        <div class="content-grid">
          <div class="main-content">
            <div class="description-box">
              <h2>{t.enroll?.sections?.about || 'About the Program'}</h2>
              <p>{currentCohort.description}</p>
            </div>

            <div class="highlights-box">
              <h2>{t.enroll?.sections?.highlights || 'Highlights'}</h2>
              <ul class="highlights-list">
                {currentCohort.highlights.map((highlight: string) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>

            {currentCohort.status === 'open' && (
              <div class="registration-box">
                <h2>{t.enroll?.sections?.register || 'Register Now'}</h2>
                <p>{t.enroll?.register?.description || 'Complete the registration form to join this cohort.'}</p>
                <a href={`/${locale === 'es' ? '' : locale + '/'}#registro`} class="btn btn-primary btn-large">
                  {t.enroll?.register?.cta || 'Go to Registration Form'}
                </a>
              </div>
            )}

            {currentCohort.status === 'upcoming' && cohort === 'chaincode-2025' && (
              <div class="registration-box chaincode-form">
                <h2>{t.enroll?.sections?.register || 'Registration Form'}</h2>
                <p>{t.enroll?.chaincode?.formDescription || 'Complete the following form to apply to the Chaincode Labs program.'}</p>

                <form class="chaincode-registration-form" id="chaincodeForm">
                  <div class="form-group">
                    <label for="firstName" class="required">
                      {t.enroll?.chaincode?.firstName || 'First Name / NYM'}
                    </label>
                    <input
                      type="text"
                      id="firstName"
                      name="firstName"
                      required
                    />
                  </div>

                  <div class="form-group">
                    <label for="lastName" class="required">
                      {t.enroll?.chaincode?.lastName || 'Last Name / NYM'}
                    </label>
                    <input
                      type="text"
                      id="lastName"
                      name="lastName"
                      required
                    />
                  </div>

                  <div class="form-group">
                    <label for="email" class="required">
                      {t.enroll?.chaincode?.email || 'Email'}
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                    />
                  </div>

                  <div class="form-group">
                    <label for="github" class="required">
                      {t.enroll?.chaincode?.github || 'GitHub Username'}
                    </label>
                    <input
                      type="text"
                      id="github"
                      name="github"
                      placeholder="e.g. satoshi NOT https://github.com/satoshi"
                      required
                    />
                    <small class="form-help">
                      {t.enroll?.chaincode?.githubHelp || 'Just the username, not the full URL'}
                    </small>
                  </div>

                  <div class="form-group">
                    <label for="linkedin">
                      {t.enroll?.chaincode?.linkedin || 'LinkedIn (optional)'}
                    </label>
                    <input
                      type="url"
                      id="linkedin"
                      name="linkedin"
                      placeholder="https://linkedin.com/in/username"
                    />
                  </div>

                  <div class="form-group">
                    <label class="required">
                      {t.enroll?.chaincode?.seminarParticipation || 'Did you participate in Chaincode Labs seminars?'}
                    </label>
                    <div class="radio-group">
                      <label class="radio-label">
                        <input
                          type="radio"
                          name="seminarParticipation"
                          value="start-career"
                          required
                        />
                        <span>{t.enroll?.chaincode?.seminarOption1 || 'Yes, I participated in the Start Your Career in Bitcoin Open Source Program'}</span>
                      </label>
                      <label class="radio-label">
                        <input
                          type="radio"
                          name="seminarParticipation"
                          value="completed-protocol"
                          required
                        />
                        <span>{t.enroll?.chaincode?.seminarOption2 || 'Yes, I completed the Bitcoin Protocol and/or Lightning Protocol Development seminar'}</span>
                      </label>
                      <label class="radio-label">
                        <input
                          type="radio"
                          name="seminarParticipation"
                          value="not-completed"
                          required
                        />
                        <span>{t.enroll?.chaincode?.seminarOption3 || 'I participated in a seminar, but did not complete it'}</span>
                      </label>
                      <label class="radio-label">
                        <input
                          type="radio"
                          name="seminarParticipation"
                          value="no"
                          required
                        />
                        <span>{t.enroll?.chaincode?.seminarOption4 || 'No'}</span>
                      </label>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>
                      {t.enroll?.chaincode?.experience || 'Experience with (optional)'}
                    </label>
                    <div class="checkbox-group">
                      <label class="checkbox-label">
                        <input
                          type="checkbox"
                          name="experience"
                          value="rust"
                        />
                        <span>Rust</span>
                      </label>
                      <label class="checkbox-label">
                        <input
                          type="checkbox"
                          name="experience"
                          value="cpp"
                        />
                        <span>C++</span>
                      </label>
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="whyParticipate" class="required">
                      {t.enroll?.chaincode?.whyParticipate || 'Why do you want to participate?'}
                    </label>
                    <textarea
                      id="whyParticipate"
                      name="whyParticipate"
                      rows="4"
                      required
                    ></textarea>
                  </div>

                  <div class="form-group">
                    <label for="goalAfterCompletion" class="required">
                      {t.enroll?.chaincode?.goalAfterCompletion || 'What is your goal after completing the program?'}
                    </label>
                    <textarea
                      id="goalAfterCompletion"
                      name="goalAfterCompletion"
                      rows="4"
                      required
                    ></textarea>
                  </div>

                  <div class="form-group">
                    <label for="interestedProjects">
                      {t.enroll?.chaincode?.interestedProjects || 'Which projects are you interested in? (optional)'}
                    </label>
                    <textarea
                      id="interestedProjects"
                      name="interestedProjects"
                      rows="3"
                    ></textarea>
                  </div>

                  <div class="form-group">
                    <label for="referralSource" class="required">
                      {t.enroll?.chaincode?.referralSource || 'How did you hear about this program?'}
                    </label>
                    <input
                      type="text"
                      id="referralSource"
                      name="referralSource"
                      placeholder={t.enroll?.chaincode?.referralPlaceholder || 'If someone referred you, who?'}
                      required
                    />
                  </div>

                  <div class="form-actions">
                    <button type="submit" class="btn btn-yellow btn-large">
                      {t.enroll?.chaincode?.submitButton || 'Submit Application'}
                    </button>
                  </div>
                </form>
              </div>
            )}

            {currentCohort.status === 'upcoming' && cohort !== 'chaincode-2025' && (
              <div class="waitlist-box">
                <h2>{t.enroll?.sections?.notify || 'Receive Notifications'}</h2>
                <p>{t.enroll?.waitlist?.description || 'Leave your email and we will notify you when registration opens.'}</p>
                <form class="waitlist-form" id="waitlistForm">
                  <input
                    type="email"
                    name="email"
                    placeholder={t.enroll?.waitlist?.placeholder || 'your@email.com'}
                    required
                  />
                  <button type="submit" class="btn btn-primary">
                    {t.enroll?.waitlist?.cta || 'Notify Me'}
                  </button>
                </form>
              </div>
            )}

            {currentCohort.status === 'completed' && (
              <div class="results-box">
                <h2>{t.enroll?.sections?.results || 'Program Results'}</h2>
                <p>{t.enroll?.results?.description || 'This program has been successfully completed.'}</p>
              </div>
            )}
          </div>

          <div class="sidebar">
            <div class="info-card">
              <h3>{t.enroll?.sidebar?.title || 'Program Information'}</h3>
              <dl class="info-list">
                <dt>{t.enroll?.sidebar?.status || 'Status'}</dt>
                <dd>
                  <span class={`inline-badge status-${currentCohort.status}`}>
                    {t.programs?.statusLabels?.[currentCohort.status] || currentCohort.status}
                  </span>
                </dd>

                <dt>{t.enroll?.sidebar?.dates || 'Dates'}</dt>
                <dd>{currentCohort.dates}</dd>
              </dl>

              <a href={`/${locale === 'es' ? '' : locale + '/'}programs`} class="btn btn-secondary btn-full">
                {t.enroll?.sidebar?.back || 'View All Programs'}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const waitlistForm = document.getElementById('waitlistForm');
      const chaincodeForm = document.getElementById('chaincodeForm');

      if (waitlistForm) {
        waitlistForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(waitlistForm as HTMLFormElement);
          const email = formData.get('email');

          // Here you would typically send to your waitlist API
          console.log('Waitlist signup:', email);

          // Show success message (you can customize this)
          alert('Thank you! We will notify you when registration opens.');
          (waitlistForm as HTMLFormElement).reset();
        });
      }

      if (chaincodeForm) {
        chaincodeForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(chaincodeForm as HTMLFormElement);

          // Get all form values
          const data = {
            firstName: formData.get('firstName'),
            lastName: formData.get('lastName'),
            email: formData.get('email'),
            github: formData.get('github'),
            linkedin: formData.get('linkedin'),
            seminarParticipation: formData.get('seminarParticipation'),
            experience: formData.getAll('experience'),
            whyParticipate: formData.get('whyParticipate'),
            goalAfterCompletion: formData.get('goalAfterCompletion'),
            interestedProjects: formData.get('interestedProjects'),
            referralSource: formData.get('referralSource')
          };

          // Here you would typically send to your API endpoint
          console.log('Chaincode application:', data);

          // Show success message
          alert('Thank you for your application! We will contact you soon.');
          (chaincodeForm as HTMLFormElement).reset();
        });
      }
    });
  </script>
</Layout>

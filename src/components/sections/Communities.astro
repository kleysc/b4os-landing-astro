---
// Communities component for B4OS landing page
---

<section class="communities-section">
    <div class="container">
        <div class="communities-content">
            <article class="communities-support">
                <header class="strategic-header">
                    <h3 class="strategic-title">Comunidades</h3>
                </header>
                <div class="communities-logos" role="group" aria-label="Logos de comunidades que apoyan B4OS">
                    <a href="https://co.linkedin.com/company/blockchain-colombia" target="_blank" rel="noopener">
                        <img src="/blockchain-colombia.jpg" alt="Blockchain Colombia - Comunidad Bitcoin Colombia" class="community-logo" width="150" height="60" loading="lazy">
                    </a>
                    <a href="https://lacrypta.ar" target="_blank" rel="noopener">
                        <img src="/lacrypta.svg" alt="La Crypta - Comunidad Bitcoin Argentina" class="community-logo" width="150" height="60" loading="lazy">
                    </a>
                    <a href="https://achicrip.org" target="_blank" rel="noopener">
                        <img src="/ongbtcchile.png" alt="Bitcoin Chile - Comunidad Bitcoin Chile" class="community-logo" height="100" loading="lazy">
                    </a>
                </div>
            </article>
        </div>
    </div>
</section>

---
export interface Props {
  stats: Array<{
    id: string | number;
    title: string;
    subtitle?: string;
    description?: string;
    icon?: string;
    color?: 'blue' | 'green' | 'purple' | 'orange' | 'red' | 'gray' | 'indigo' | 'pink' | 'yellow' | 'cyan';
    trend?: string;
    trendDirection?: 'up' | 'down' | 'neutral';
    value?: string | number;
    prefix?: string;
    suffix?: string;
    animation?: boolean;
  }>;
  columns?: 2 | 3 | 4 | 6;
  variant?: 'default' | 'cards' | 'minimal' | 'gradient' | 'glass';
  showTrends?: boolean;
  showIcons?: boolean;
  animate?: boolean;
  class?: string;
}

const {
  stats,
  columns = 4,
  variant = 'default',
  showTrends = true,
  showIcons = true,
  animate = false,
  class: className = ''
} = Astro.props;

const gridClasses = {
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-3',
  4: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4',
  6: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6'
};

const variantClasses = {
  default: 'bg-white rounded-lg p-6 shadow-sm border border-gray-200 hover:shadow-md transition-all duration-300',
  cards: 'bg-white rounded-xl p-8 shadow-lg border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300',
  minimal: 'bg-transparent p-4 border-l-4 border-blue-500 pl-6 hover:bg-gray-50 transition-colors duration-200',
  gradient: 'bg-gradient-to-br from-blue-50 to-indigo-100 rounded-xl p-6 border border-blue-200 hover:from-blue-100 hover:to-indigo-200 transition-all duration-300',
  glass: 'bg-white/80 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-white/20 hover:bg-white/90 transition-all duration-300'
};

const colorClasses = {
  blue: 'bg-blue-100 text-blue-600 border-blue-200',
  green: 'bg-green-100 text-green-600 border-green-200',
  purple: 'bg-purple-100 text-purple-600 border-purple-200',
  orange: 'bg-orange-100 text-orange-600 border-orange-200',
  red: 'bg-red-100 text-red-600 border-red-200',
  gray: 'bg-gray-100 text-gray-600 border-gray-200',
  indigo: 'bg-indigo-100 text-indigo-600 border-indigo-200',
  pink: 'bg-pink-100 text-pink-600 border-pink-200',
  yellow: 'bg-yellow-100 text-yellow-600 border-yellow-200',
  cyan: 'bg-cyan-100 text-cyan-600 border-cyan-200'
};

const classes = [
  'grid gap-6',
  gridClasses[columns],
  className
].filter(Boolean).join(' ');

// Icon mapping for common icons
const iconMap: Record<string, string> = {
  'users': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path></svg>`,
  'code': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>`,
  'star': `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>`,
  'rocket': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`,
  'lightbulb': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`,
  'heart': `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path></svg>`,
  'trophy': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 3.143L13 21l-2.286-6.857L5 12l5.714-3.143L13 3z"></path></svg>`,
  'chart': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>`
};

const getIcon = (iconName: string) => {
  return iconMap[iconName] || `<span class="text-2xl">${iconName}</span>`;
};

const getTrendIcon = (direction: string) => {
  switch (direction) {
    case 'up':
      return `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>`;
    case 'down':
      return `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path></svg>`;
    default:
      return `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14"></path></svg>`;
  }
};

const getTrendColor = (direction: string) => {
  switch (direction) {
    case 'up':
      return 'text-green-600 bg-green-50';
    case 'down':
      return 'text-red-600 bg-red-50';
    default:
      return 'text-gray-600 bg-gray-50';
  }
};

const getStatColor = (color: 'blue' | 'green' | 'purple' | 'orange' | 'red' | 'gray' | 'indigo' | 'pink' | 'yellow' | 'cyan' = 'blue') => {
  return colorClasses[color] || colorClasses.blue;
};
---

<div class={classes}>
  {stats.map((stat, index) => (
    <div 
      class={`${variantClasses[variant]} ${animate ? 'animate-fade-in' : ''}`}
      style={animate ? `animation-delay: ${index * 100}ms` : ''}
    >
      <div class="flex items-center justify-between mb-4">
        {showIcons && stat.icon && (
          <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${getStatColor(stat.color)}`}>
            <span set:html={getIcon(stat.icon)}></span>
          </div>
        )}
        
        {showTrends && stat.trend && (
          <div class={`flex items-center px-2 py-1 rounded-full text-xs font-medium ${getTrendColor(stat.trendDirection || 'neutral')}`}>
            <span class="mr-1" set:html={getTrendIcon(stat.trendDirection || 'neutral')}></span>
            {stat.trend}
          </div>
        )}
      </div>
      
      <div class="mb-2">
        {stat.prefix && (
          <span class="text-lg font-medium text-gray-500">{stat.prefix}</span>
        )}
        <span class="text-3xl font-bold text-gray-900">
          {stat.value !== undefined ? stat.value : stat.title}
        </span>
        {stat.suffix && (
          <span class="text-lg font-medium text-gray-500">{stat.suffix}</span>
        )}
      </div>
      
      {stat.subtitle && (
        <div class="text-lg font-medium text-gray-700 mb-2">
          {stat.subtitle}
        </div>
      )}
      
      {stat.description && (
        <div class="text-sm text-gray-600">
          {stat.description}
        </div>
      )}
    </div>
  ))}
</div>

<style>
  /* Animation classes */
  .animate-fade-in {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Hover effects for different variants */
  .hover\:shadow-md:hover {
    transform: translateY(-2px);
  }
  
  .hover\:-translate-y-1:hover {
    transform: translateY(-4px);
  }
  
  /* Icon hover effects */
  .w-12.h-12 svg {
    transition: transform 0.3s ease;
  }
  
  .w-12.h-12:hover svg {
    transform: scale(1.1);
  }
  
  /* Trend indicator animations */
  .flex.items-center.px-2.py-1.rounded-full {
    transition: all 0.3s ease;
  }
  
  .flex.items-center.px-2.py-1.rounded-full:hover {
    transform: scale(1.05);
  }
  
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .text-3xl { font-size: 1.875rem; }
    .text-lg { font-size: 1rem; }
  }
</style>

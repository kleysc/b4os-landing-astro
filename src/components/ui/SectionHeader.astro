---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  alignment?: 'left' | 'center' | 'right';
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  variant?: 'default' | 'gradient' | 'minimal' | 'bordered' | 'highlighted';
  showDivider?: boolean;
  dividerColor?: 'blue' | 'green' | 'purple' | 'orange' | 'red' | 'gray';
  icon?: string;
  iconPosition?: 'top' | 'left' | 'right';
  badge?: string;
  badgeColor?: 'primary' | 'secondary' | 'success' | 'warning' | 'danger' | 'info';
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl';
  class?: string;
}

const {
  title,
  subtitle,
  description,
  alignment = 'center',
  size = 'lg',
  variant = 'default',
  showDivider = true,
  dividerColor = 'blue',
  icon,
  iconPosition = 'top',
  badge,
  badgeColor = 'primary',
  maxWidth = '3xl',
  class: className = ''
} = Astro.props;

const alignmentClasses = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right'
};

const sizeClasses = {
  sm: {
    title: 'text-2xl font-bold',
    subtitle: 'text-lg font-medium',
    description: 'text-base'
  },
  md: {
    title: 'text-3xl font-bold',
    subtitle: 'text-xl font-medium',
    description: 'text-lg'
  },
  lg: {
    title: 'text-4xl font-bold',
    subtitle: 'text-2xl font-medium',
    description: 'text-xl'
  },
  xl: {
    title: 'text-5xl font-bold',
    subtitle: 'text-3xl font-medium',
    description: 'text-2xl'
  },
  '2xl': {
    title: 'text-6xl font-bold',
    subtitle: 'text-4xl font-medium',
    description: 'text-3xl'
  }
};

const variantClasses = {
  default: '',
  gradient: 'bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent',
  minimal: 'font-light',
  bordered: 'border-l-4 border-blue-500 pl-6',
  highlighted: 'bg-blue-50 dark:bg-blue-900/20 p-6 rounded-lg'
};

const dividerColorClasses = {
  blue: 'bg-blue-600',
  green: 'bg-green-600',
  purple: 'bg-purple-600',
  orange: 'bg-orange-600',
  red: 'bg-red-600',
  gray: 'bg-gray-600'
};

const badgeColorClasses = {
  primary: 'bg-blue-100 text-blue-800 border-blue-200',
  secondary: 'bg-gray-100 text-gray-800 border-gray-200',
  success: 'bg-green-100 text-green-800 border-green-200',
  warning: 'bg-yellow-100 text-yellow-800 border-yellow-200',
  danger: 'bg-red-100 text-red-800 border-red-200',
  info: 'bg-cyan-100 text-cyan-800 border-cyan-200'
};

const maxWidthClasses = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
  '2xl': 'max-w-2xl',
  '3xl': 'max-w-3xl',
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
  '7xl': 'max-w-7xl'
};

const classes = [
  'mb-12',
  alignmentClasses[alignment],
  variant === 'bordered' ? 'border-l-4 border-blue-500 pl-6' : '',
  variant === 'highlighted' ? 'bg-blue-50 dark:bg-blue-900/20 p-6 rounded-lg' : '',
  className
].filter(Boolean).join(' ');

// Icon mapping for common icons
const iconMap: Record<string, string> = {
  'star': `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>`,
  'rocket': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`,
  'lightbulb': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`,
  'users': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path></svg>`,
  'code': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>`,
  'heart': `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path></svg>`
};

const getIcon = (iconName: string) => {
  return iconMap[iconName] || `<span class="w-6 h-6">${iconName}</span>`;
};

const iconSizeClasses = {
  sm: 'w-8 h-8',
  md: 'w-12 h-12',
  lg: 'w-16 h-16',
  xl: 'w-20 h-20',
  '2xl': 'w-24 h-24'
};
---

<div class={classes}>
  <!-- Badge -->
  {badge && (
    <div class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-medium border ${badgeColorClasses[badgeColor]} mb-4`}>
      {badge}
    </div>
  )}

  <!-- Icon -->
  {icon && iconPosition === 'top' && (
    <div class={`${iconSizeClasses[size]} mx-auto mb-4 text-blue-600`} set:html={getIcon(icon)}></div>
  )}

  <!-- Content Container -->
  <div class={maxWidthClasses[maxWidth]}>
    {icon && iconPosition === 'left' && (
      <div class="flex items-center gap-4">
        <div class={`${iconSizeClasses[size]} text-blue-600 flex-shrink-0`} set:html={getIcon(icon)}></div>
        <div class="flex-1">
          {subtitle && (
            <p class={`${sizeClasses[size].subtitle} text-blue-600 mb-2 font-medium`}>
              {subtitle}
            </p>
          )}
          
          <h2 class={`${sizeClasses[size].title} text-gray-900 mb-4 leading-tight ${variantClasses[variant]}`}>
            {title}
          </h2>
          
          {description && (
            <p class={`${sizeClasses[size].description} text-gray-600 leading-relaxed`}>
              {description}
            </p>
          )}
        </div>
      </div>
    )}

    {icon && iconPosition === 'right' && (
      <div class="flex items-center gap-4">
        <div class="flex-1">
          {subtitle && (
            <p class={`${sizeClasses[size].subtitle} text-blue-600 mb-2 font-medium`}>
              {subtitle}
            </p>
          )}
          
          <h2 class={`${sizeClasses[size].title} text-gray-900 mb-4 leading-tight ${variantClasses[variant]}`}>
            {title}
          </h2>
          
          {description && (
            <p class={`${sizeClasses[size].description} text-gray-600 leading-relaxed`}>
              {description}
            </p>
          )}
        </div>
        <div class={`${iconSizeClasses[size]} text-blue-600 flex-shrink-0`} set:html={getIcon(icon)}></div>
      </div>
    )}

    {(!icon || iconPosition === 'top') && (
      <>
        {subtitle && (
          <p class={`${sizeClasses[size].subtitle} text-blue-600 mb-2 font-medium`}>
            {subtitle}
          </p>
        )}
        
        <h2 class={`${sizeClasses[size].title} text-gray-900 mb-4 leading-tight ${variantClasses[variant]}`}>
          {title}
        </h2>
        
        {description && (
          <p class={`${sizeClasses[size].description} text-gray-600 leading-relaxed`}>
            {description}
          </p>
        )}
      </>
    )}
  </div>
  
  <!-- Divider -->
  {showDivider && (
    <div class={`w-24 h-1 ${dividerColorClasses[dividerColor]} ${alignment === 'center' ? 'mx-auto' : alignment === 'right' ? 'ml-auto' : ''} mt-8 rounded-full`}></div>
  )}
</div>

<style>
  /* Gradient text animation */
  .bg-gradient-to-r {
    background-size: 200% 200%;
    animation: gradient 3s ease infinite;
  }
  
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  
  /* Icon hover effects */
  .text-blue-600 svg {
    transition: transform 0.3s ease, color 0.3s ease;
  }
  
  .text-blue-600:hover svg {
    transform: scale(1.1);
    color: #1d4ed8;
  }
  
  /* Badge animations */
  .inline-flex.items-center.px-3.py-1 {
    animation: fadeInUp 0.5s ease-out;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .text-6xl { font-size: 2.5rem; }
    .text-5xl { font-size: 2rem; }
    .text-4xl { font-size: 1.875rem; }
  }
</style>
